{
  "name": "openbingeboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "typecheck:ci": "react-router typegen && tsc -b",
    "deploy": "pnpm build && doppler run --config prd -- wrangler deploy",
    "preview": "pnpm build && vite preview",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply openbingeboard --local",
    "db:migrate:remote": "doppler run --config prd -- wrangler d1 migrations apply openbingeboard --remote",
    "db:seed": "wrangler d1 execute openbingeboard --local --file=db/seed.sql",
    "db:reset": "pnpm db:migrate:local && pnpm db:seed",
    "ingest": "doppler run -- tsx scripts/ingest.ts",
    "ingest:dry": "doppler run -- tsx scripts/ingest.ts --dry-run",
    "ingest:apply": "doppler run -- bash scripts/ingest-apply.sh",
    "ingest:apply:prd": "doppler run --config prd -- bash scripts/ingest-apply.sh",
    "embed:titles": "doppler run --config prd -- tsx scripts/embed-titles.ts",
    "embed:apply:prd": "doppler run --config prd -- bash scripts/embed-apply.sh",
    "models:sync": "tsx scripts/sync-models.ts",
    "models:check": "tsx scripts/sync-models.ts --check",
    "eval:semantic": "tsx scripts/eval-semantic.ts",
    "secrets": "doppler secrets --only-names",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@effect/sql-d1": "4.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/transformers": "^4.3.2",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "effect": "4.1.6",
    "isbot": "^5.1.36",
    "kysely": "^0.29.9",
    "kysely-d1": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "shadcn": "4.23.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.168.0"
  }
}
