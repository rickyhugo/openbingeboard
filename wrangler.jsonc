{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbingeboard",
  "compatibility_date": "2026-11-23",
  "main": "./workers/app.ts",
  "vars": {
    "REGION": "SE",
    "BETTER_AUTH_URL": "https://openbingeboard.hugoplanet.se",
    "EMAIL_FROM": "OpenBingeBoard <noreply@hugoplanet.se>",
  },
  "routes": [
    {
      "pattern": "openbingeboard.hugoplanet.se",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbingeboard",
      "database_id": "be5efb5b-b4fd-4409-a38f-4def80adc89a",
      "migrations_dir": "db/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
