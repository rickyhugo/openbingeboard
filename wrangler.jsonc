{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbingeboard",
  "account_id": "bc7f7d5c218d4e8521d7e56c169450ff",
  "compatibility_date": "2026-11-23",
  "main": "./workers/app.ts",
  "vars": {
    "BETTER_AUTH_URL": "https://openbingeboard.com",
    "EMAIL_FROM": "OpenBingeBoard <noreply@openbingeboard.com>",
  },
  // The custom domain is owned by Terraform (modules/bingeboard in
  // hugoplanet-infrastructure). Do not declare it here: Wrangler replaces the
  // Worker's domain set on deploy and would fight Terraform for ownership.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbingeboard",
      "database_id": "be5efb5b-b4fd-4409-a38f-4def80adc89a",
      "migrations_dir": "db/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
